# Copy this file to .env.local and fill in the values. .env.local is gitignored.
#
# READ THIS FIRST
# ---------------
# Vite inlines every VITE_* variable into the JavaScript bundle at build time.
# .env.local keeps the key out of the git history, but it does NOT keep it out
# of the deployed site: anyone can open DevTools on the live page and read it.
#
# For a public site there are two honest options:
#   1. Use a free, rate-limited, disposable key and rotate it if it gets abused.
#   2. Put a proxy (Cloudflare Worker, Hugging Face Space, Vercel function) in
#      front of the model, keep the key there, and set VITE_CHAT_ENDPOINT below
#      instead of VITE_GROQ_API_KEY. This is the only way the key stays secret.

# Option 1 — direct call from the browser. Get a free key at https://console.groq.com/keys
VITE_GROQ_API_KEY=

# Option 2 — a proxy that adds the Authorization header itself.
# Must accept an OpenAI-style POST body. Leave blank to call Groq directly.
VITE_CHAT_ENDPOINT=

# Optional model override. Groq retires models regularly — check the current
# catalogue at https://console.groq.com/docs/models if chat starts 404ing.
VITE_CHAT_MODEL=openai/gpt-oss-120b
